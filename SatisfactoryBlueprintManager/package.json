{
  "name": "satisfactoryblueprintmanager",
  "version": "0.0.1",
  "description": "A Quasar Project",
  "productName": "SatisfactoryBlueprintManager",
  "author": "zhaowendao2005 <140528990+zhaowendao2005@users.noreply.github.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "lint": "eslint -c ./eslint.config.js \"./Frontend*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "node ../Script/run-with-logger.mjs --name dev -- quasar dev",
    "dev:no-lint": "cross-env SKIP_LINT=true node ../Script/run-with-logger.mjs --name dev-no-lint -- quasar dev",
    "dev:electron": "node ../Script/run-with-logger.mjs --name dev-electron -- quasar dev -m electron",
    "dev:electron:no-lint": "cross-env SKIP_LINT=true node ../Script/run-with-logger.mjs --name dev-electron-no-lint -- quasar dev -m electron",
    "build": "quasar build",
    "build:python": "node ../Script/build-python-service.mjs",
    "build:electron": "node ../Script/run-with-logger.mjs --name build-electron -- quasar build -m electron",
    "build:electron:no-lint": "cross-env SKIP_LINT=true node ../Script/run-with-logger.mjs --name build-electron-no-lint -- quasar build -m electron",
    "build:electron:debug:no-lint": "cross-env SKIP_LINT=true node ../Script/run-with-logger.mjs --name build-electron-debug-no-lint -- quasar build -m electron",
    "create:summary": "node ../Script/create-summary.js",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "axios": "^1.2.1",
    "element-plus": "^2.9.1",
    "p-limit": "^4.0.0",
    "pinia": "^3.0.1",
    "quasar": "^2.16.0",
    "vue": "^3.4.18",
    "vue-i18n": "^11.0.0",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@electron/packager": "^18.4.4",
    "@eslint/js": "^9.14.0",
    "@intlify/unplugin-vue-i18n": "^4.0.0",
    "@quasar/app-vite": "^2.1.0",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "autoprefixer": "^10.4.2",
    "cross-env": "^7.0.3",
    "electron": "^39.0.0",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "prettier": "^3.3.3",
    "typescript": "~5.5.3",
    "unplugin-auto-import": "^0.18.5",
    "unplugin-vue-components": "^0.27.4",
    "vite-plugin-checker": "^0.9.0",
    "vue-tsc": "^2.0.29"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
